<policies>
    <inbound>
        <base />

        <rate-limit calls="100" renewal-period="60" />

        <!-- SOLO reescribir para POST -->
        <choose>
            <when condition="@(context.Request.Method == 'POST')">
                <rewrite-uri template="/api/transactions" />
            </when>
        </choose>

        <set-backend-service backend-id="aks-ingress-backend" />
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>
