<policies>
    <inbound>
        <base />

        <rate-limit calls="100" renewal-period="60" />

        <!-- SOLO reescribir cuando sea POST -->
        <rewrite-uri
                template="/api/transactions"
                condition="@(context.Request.Method == &quot;POST&quot;)" />

        <set-backend-service backend-id="aks-ingress-backend" />
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>
